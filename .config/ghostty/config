# river config
# created on 2025/02/08

window-height = 28
window-width = 90
window-position-x = 600
window-position-y = 326
window-save-state = always

background-opacity = 0.9
background-blur-radius = 30
custom-shader = shaders/cursor_warp.glsl

font-size = 16

# WARNING: do not put comments after the font name
# -> => ${} == === != !== ++ <= >= 000
# font-family = JetBrains Mono
# font-variation = wght=600
# font-feature = +zero, +ss02, +ss19
# zero is strikethrough zero
# ss02 is more playful curlies
# ss19 is disable ligatures for equals

# no medium, has ligatures, has strikethrough zero
# font-family = Fantasque Sans Mono
# adjust-cell-height = 10%
# font-size = 18

# font-family = Victor Mono
# font-style = SemiBold
# font-size = 17
# # adjust-cell-height = -12%

# font-family = Hack
# adjust-cell-height = 14%

font-family = Cascadia Code
font-variation = wght=500
# ss19 is slashed zero
font-feature = +ss19
adjust-cell-height = 14%

# font-family = Dank Mono
# font-style = Bold
# adjust-cell-height = 18%
# font-size = 18

# font-family = BlexMono Nerd Font Medium
# adjust-cell-height = 0%

# font-family = Fira Code
# font-style = Medium
# adjust-cell-height = 10%
# font-size = 15.5

# font-family = BerkeleyMono Nerd Font
# font-style = Bold
# adjust-cell-height = 10%

# font-family = Ioskeley Mono
# font-style = Medium
# adjust-cell-height = 6%

# TX-02 is berkeley mono official
# font-family = TX-02 Medium
# adjust-cell-height = 10%

# no medium
# font-family = Menlo
# adjust-cell-height = 14%

# no medium
# font-family = PT Mono
# adjust-cell-height = 16%


cursor-style = block
# cursor-style-blink = true
shell-integration-features = no-cursor
macos-titlebar-style = tabs
shell-integration = zsh
mouse-hide-while-typing = true
macos-icon = xray

# good themes:
# Aardvark Blue
# catppuccin-frappe
# catppuccin-macchiato
# catppuccin-mocha
# Aura
# AtelierSulphurpool
# duskfox
# FrontEndDelight
theme = tokyonight

keybind = global:cmd+f20=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0
quick-terminal-size = 70%,100%

keybind = cmd+s=goto_split:next
keybind = cmd+d=new_split:right
keybind = cmd+g=goto_split:previous
