cursor-style = block
# cursor-style-blink = true
shell-integration-features = no-cursor
macos-titlebar-style = tabs
shell-integration = zsh
mouse-hide-while-typing = true
macos-icon = xray
adjust-underline-thickness = 50%

keybind = global:cmd+f20=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0
quick-terminal-size = 70%,100%

keybind = cmd+s=goto_split:next
keybind = cmd+d=new_split:right
keybind = cmd+g=goto_split:previous

# dont forget to change indent guidelines lerp color
# when changing the theme
theme = everblush

